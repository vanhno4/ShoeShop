@page
@model ShoeShop.Pages.LoginModel
@{
    ViewData["Title"] = "Đăng Nhập";
}

<div class="flex min-h-full items-center justify-center py-12 px-4 sm:px-6 lg:px-8">
    <div class="w-full max-w-md space-y-8 bg-white p-10 shadow-lg rounded-lg border border-gray-200">
        <div>
            <h2 class="mt-6 text-center text-3xl font-bold tracking-tight text-gray-900">
                Đăng nhập vào tài khoản
            </h2>
            <p class="mt-2 text-center text-sm text-gray-600">
                Hoặc
                <a asp-page="/Register" class="font-medium text-blue-600 hover:text-blue-500">
                    tạo một tài khoản mới
                </a>
            </p>
        </div>

        <form class="mt-8 space-y-6" method="post">

            <!-- Hien thi thong bao LỖI (Mau do) -->
            @if (!string.IsNullOrEmpty(Model.ErrorMessage))
            {
                <div class="rounded-md bg-red-50 p-4">
                    <div class="flex">
                        <div class="ml-3">
                            <h3 class="text-sm font-medium text-red-800">@Model.ErrorMessage</h3>
                        </div>
                    </div>
                </div>
            }

            <!-- --- THÊM MỚI --- -->
            <!-- Hien thi thong bao THANH CONG (Mau xanh) -->
            <!-- (Thong bao nay se xuat hien sau khi doi mat khau thanh cong) -->
            @if (!string.IsNullOrEmpty(Model.SuccessMessage))
            {
                <div class="rounded-md bg-green-50 p-4">
                    <h3 class="text-sm font-medium text-green-800">@Model.SuccessMessage</h3>
                </div>
            }
            <!-- --- KẾT THÚC THÊM --- -->

            <div class="space-y-4 rounded-md shadow-sm">
                <div>
                    <label asp-for="Username" class="sr-only">Tên đăng nhập</label>
                    <input asp-for="Username" class="relative block w-full appearance-none rounded-md border border-gray-300 px-3 py-3 text-gray-900 placeholder-gray-500 focus:z-10 focus:border-blue-500 focus:outline-none focus:ring-blue-500 sm:text-sm" placeholder="Tên đăng nhập">
                    <span asp-validation-for="Username" class="text-red-600 text-sm"></span>
                </div>

                <div>
                    <label asp-for="Password" class="sr-only">Mật khẩu</label>
                    <input asp-for="Password" class="relative block w-full appearance-none rounded-md border border-gray-300 px-3 py-3 text-gray-900 placeholder-gray-500 focus:z-10 focus:border-blue-500 focus:outline-none focus:ring-blue-500 sm:text-sm" placeholder="Mật khẩu">
                    <span asp-validation-for="Password" class="text-red-600 text-sm"></span>
                </div>
            </div>

            <!-- --- SỬA LẠI LINK "QUÊN MẬT KHẨU" --- -->
            <div class="flex items-center justify-end">
                <div class="text-sm">
                    <a asp-page="/ForgotPassword" class="font-medium text-blue-600 hover:text-blue-500">Quên mật khẩu?</a>
                </div>
            </div>
            <!-- --- KẾT THÚC SỬA --- -->

            <div>
                <button type="submit" class="group relative flex w-full justify-center rounded-md border border-transparent bg-blue-600 py-3 px-4 text-sm font-medium text-white hover:bg-blue-700 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:ring-offset-2">
                    Đăng Nhập
                </button>
            </div>
        </form>
    </div>
</div>