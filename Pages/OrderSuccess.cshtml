@page
@model ShoeShop.Pages.OrderSuccessModel
@{
    ViewData["Title"] = "Thanh toán thành công";
}

<div class="bg-gray-50 min-h-screen pt-12 pb-12">
    <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="bg-white rounded-lg shadow-lg overflow-hidden">

            <div class="bg-indigo-600 px-6 py-10 sm:px-10 text-center">
                <div class="mx-auto flex items-center justify-center h-20 w-20 rounded-full bg-white mb-6">
                    <i class="fa-solid fa-check text-4xl text-indigo-600"></i>
                </div>
                <h1 class="text-3xl font-extrabold text-white">Thanh toán thành công!</h1>
                <p class="mt-2 text-lg text-indigo-100">Cảm ơn bạn đã mua sắm tại ShoeVibe.</p>
            </div>

            <div class="px-6 py-10 sm:px-10">
                <h2 class="text-lg font-medium text-gray-900 mb-6">Chi tiết đơn hàng vừa đặt:</h2>

                <div class="border border-gray-200 rounded-md overflow-hidden">
                    <ul role="list" class="divide-y divide-gray-200">
                        @foreach (var item in Model.OrderItems)
                        {
                            <li class="flex p-4 bg-gray-50">
                                <div class="h-16 w-16 flex-shrink-0 overflow-hidden rounded-md border border-gray-200">
                                    <img src="@item.ProductImage" alt="@item.ProductName" class="h-full w-full object-cover object-center">
                                </div>

                                <div class="ml-4 flex-1 flex flex-col">
                                    <div>
                                        <div class="flex justify-between text-base font-medium text-gray-900">
                                            <h3>@item.ProductName</h3>
                                        </div>
                                        <p class="mt-1 text-sm text-gray-500">@item.ProductCategory</p>
                                    </div>
                                    <div class="flex flex-1 items-end justify-between text-sm">
                                        <p class="text-gray-500 font-medium">Size: @item.Size</p>
                                        <p class="text-gray-900 font-bold">x @item.Quantity</p>
                                    </div>
                                </div>
                            </li>
                        }
                    </ul>
                </div>

                <div class="mt-8">
                    <p class="text-sm text-gray-500 text-center">
                        Đơn hàng của bạn đang được xử lý. Chúng tôi sẽ giao hàng trong thời gian sớm nhất.
                    </p>
                </div>
            </div>

            <div class="bg-gray-50 px-6 py-6 sm:px-10 flex flex-col sm:flex-row justify-center gap-4">
                <a asp-page="/Index" class="w-full sm:w-auto inline-flex items-center justify-center px-6 py-3 border border-transparent text-base font-medium rounded-md text-white bg-indigo-600 hover:bg-indigo-700 shadow-sm">
                    Tiếp tục mua sắm
                </a>

                <a asp-page="/OrderHistory" class="w-full sm:w-auto inline-flex items-center justify-center px-6 py-3 border border-gray-300 text-base font-medium rounded-md text-gray-700 bg-white hover:bg-gray-100 shadow-sm">
                    <i class="fa-solid fa-clock-rotate-left mr-2"></i>
                    Xem Lịch sử mua hàng
                </a>
            </div>

        </div>
    </div>
</div>