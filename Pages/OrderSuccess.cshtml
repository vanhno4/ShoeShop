@page
@model ShoeShop.Pages.OrderSuccessModel
@{
    ViewData["Title"] = "Thanh Toán Thành Công";
}

<div class="bg-white py-16 sm:py-24">
    <div class="max-w-md mx-auto text-center">
        <!-- Icon Checkmark (SVG) -->
        <svg class="mx-auto h-20 w-20 text-green-500" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
        </svg>

        <h2 class="mt-4 text-3xl font-bold tracking-tight text-gray-900 sm:text-4xl">
            Thanh toán thành công
        </h2>

        <p class="mt-4 text-lg text-gray-600">
            Cảm ơn vì đã tin tưởng sản phẩm của chúng tôi.
        </p>

        <!-- --- SUA LINK O DAY --- -->
        <p class="mt-4 text-gray-600">
            Bạn có thể xem chi tiết trong
            <a asp-page="/MyOrder" class="font-medium text-blue-600 hover:text-blue-500">
                đơn hàng của tôi.
            </a>
        </p>
        <!-- --- KET THUC SUA --- -->
        <!-- Nut quay ve Trang Chu -->
        <div class="mt-10">
            <a asp-page="/Index" class="rounded-md bg-blue-600 px-3.5 py-2.5 text-sm font-semibold text-white shadow-sm hover:bg-blue-700 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-blue-600">
                Tiếp tục mua hàng
            </a>
        </div>
    </div>
</div>