@page
@model ShoeShop.Pages.ForgotPasswordModel
@{
    ViewData["Title"] = "Quên Mật Khẩu";
}

<div class="flex min-h-full items-center justify-center py-12 px-4 sm:px-6 lg:px-8">
    <div class="w-full max-w-md space-y-8 bg-white p-10 shadow-lg rounded-lg border border-gray-200">
        <div>
            <h2 class="mt-6 text-center text-3xl font-bold tracking-tight text-gray-900">
                Khôi phục mật khẩu
            </h2>
            <p class="mt-2 text-center text-sm text-gray-600">
                Nhập tên đăng nhập và mật khẩu mới của bạn.
            </p>
        </div>

        <form class="mt-8 space-y-6" method="post">

            @if (!string.IsNullOrEmpty(Model.ErrorMessage))
            {
                <div class="rounded-md bg-red-50 p-4">
                    <h3 class="text-sm font-medium text-red-800">@Model.ErrorMessage</h3>
                </div>
            }

            <div class="space-y-4 rounded-md shadow-sm">
                <!-- Ô Tên đăng nhập -->
                <div>
                    <label asp-for="Username" class="sr-only">Tên đăng nhập</label>
                    <input asp-for="Username" class="relative block w-full appearance-none rounded-md border border-gray-300 px-3 py-3 text-gray-900 placeholder-gray-500 focus:z-10 focus:border-blue-500 focus:outline-none focus:ring-blue-500 sm:text-sm" placeholder="Tên đăng nhập">
                    <span asp-validation-for="Username" class="text-red-600 text-sm"></span>
                </div>

                <!-- --- THEM 2 O MOI --- -->
                <!-- Ô Mật khẩu mới -->
                <div>
                    <label asp-for="NewPassword" class="sr-only">Mật khẩu mới</label>
                    <input asp-for="NewPassword" class="relative block w-full appearance-none rounded-md border border-gray-300 px-3 py-3 text-gray-900 placeholder-gray-500 focus:z-10 focus:border-blue-500 focus:outline-none focus:ring-blue-500 sm:text-sm" placeholder="Mật khẩu mới (ít nhất 6 ký tự)">
                    <span asp-validation-for="NewPassword" class="text-red-600 text-sm"></span>
                </div>

                <!-- Ô Nhập lại Mật khẩu -->
                <div>
                    <label asp-for="ConfirmPassword" class="sr-only">Nhập lại mật khẩu mới</label>
                    <input asp-for="ConfirmPassword" class="relative block w-full appearance-none rounded-md border border-gray-300 px-3 py-3 text-gray-900 placeholder-gray-500 focus:z-10 focus:border-blue-500 focus:outline-none focus:ring-blue-500 sm:text-sm" placeholder="Nhập lại mật khẩu mới">
                    <span asp-validation-for="ConfirmPassword" class="text-red-600 text-sm"></span>
                </div>
                <!-- --- KET THUC THEM --- -->
            </div>

            <!-- Nút Gửi -->
            <div>
                <button type="submit" class="group relative flex w-full justify-center rounded-md border border-transparent bg-blue-600 py-3 px-4 text-sm font-medium text-white hover:bg-blue-700 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:ring-offset-2">
                    Lưu Mật Khẩu Mới
                </button>
            </div>

            <div class="text-sm text-center">
                <a asp-page="/Login" class="font-medium text-blue-600 hover:text-blue-500">
                    &larr; Quay về Đăng nhập
                </a>
            </div>
        </form>
    </div>
</div>