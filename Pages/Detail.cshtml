@page "/Detail/{id:int}"
@model ShoeShop.Pages.DetailModel
@{
    ViewData["Title"] = Model.ProductFound ? Model.Product.Name : "Không Tìm Thấy";
    ViewData["BackgroundColor"] = "bg-white";
}

<div class="bg-white">
    <div class="max-w-7xl mx-auto py-16 px-4 sm:px-6 lg:px-8">

        @if (Model.ProductFound)
        {
            <div class="grid grid-cols-1 md:grid-cols-2 gap-12">

                <!-- Cot 1: Hinh anh -->
                <div class="w-full rounded-lg overflow-hidden">
                    <img src="@Model.Product.ImageUrl"
                         alt="@Model.Product.Name"
                         onerror="this.onerror=null;this.src='https://placehold.co/600x600/E0E0E0/B0B0B0?text=Error';"
                         class="w-full h-full object-cover object-center">
                </div>

                <!-- Cot 2: Thong tin -->
                <div>
                    <h1 class="text-3xl font-bold tracking-tight text-gray-900">
                        @Model.Product.Name
                    </h1>

                    <!-- Hien thi gia (logic 2 gia) -->
                    @if (Model.Product.OriginalPrice.HasValue && Model.Product.OriginalPrice > Model.Product.Price)
                    {
                        <div class="mt-4 flex items-baseline space-x-3">
                            <p class="text-3xl font-bold tracking-tight text-red-600">
                                @Model.Product.Price.ToString("N0") ₫
                            </p>
                            <p class="text-xl text-gray-500 line-through">
                                @Model.Product.OriginalPrice.Value.ToString("N0") ₫
                            </p>
                        </div>
                    }
                    else
                    {
                        <p class="text-3xl tracking-tight text-gray-900 mt-4">
                            @Model.Product.Price.ToString("N0") ₫
                        </p>
                    }

                    <!--
                        --- THEM MOI: HIEN THI SO LUONG ---
                    -->
                    <div class="mt-6">
                        @if (Model.Product.Stock > 0)
                        {
                            <p class="text-sm text-gray-700">
                                Số lượng còn lại: <span class="font-medium text-green-600">@Model.Product.Stock</span>
                            </p>
                        }
                        else
                        {
                            <p class="text-sm font-medium text-red-600">
                                Hết Hàng
                            </p>
                        }
                    </div>
                    <!-- --- KET THUC THEM --- -->
                    <!-- Nut Them vao gio -->
                    <div class="mt-8">
                        @if (User.Identity != null && User.Identity.IsAuthenticated)
                        {
                            // --- SUA LOGIC NUT BAM ---
                            @if (Model.Product.Stock > 0)
                            {
                                <!-- Con hang: Hien nut "Them vao gio" -->
                                <a asp-page="/AddToCart" asp-route-id="@Model.Product.Id"
                                   class="inline-flex items-center justify-center rounded-md border border-transparent bg-blue-600 px-8 py-3 text-base font-medium text-white hover:bg-blue-700">
                                    Thêm vào giỏ
                                </a>
                            }
                            else
                            {
                                <!-- Het hang: Hien nut bi mo (disabled) -->
                                <button type="button" disabled
                                        class="inline-flex items-center justify-center rounded-md border border-transparent bg-gray-400 px-8 py-3 text-base font-medium text-white cursor-not-allowed">
                                    Hết Hàng
                                </button>
                            }
                        }
                        else
                        {
                            <!-- Chua dang nhap: Link den /Login (nhu cu) -->
                            <a asp-page="/Login"
                               class="inline-flex items-center justify-center rounded-md border border-transparent bg-blue-600 px-8 py-3 text-base font-medium text-white hover:bg-blue-700">
                                Thêm vào giỏ
                            </a>
                        }
                    </div>

                    <!-- Mo ta san pham -->
                    <div class="mt-8">
                        <h3 class="text-lg font-medium text-gray-900">Mô tả</h3>
                        <div class="mt-4 text-base text-gray-600 space-y-6">
                            <p>@Model.Product.Description</p>
                        </div>
                    </div>

                    <div class="mt-8 border-t border-gray-200 pt-8">
                        <a asp-page="/AllProducts" class="text-sm font-medium text-blue-600 hover:text-blue-500">
                            &larr; Xem tất cả sản phẩm
                        </a>
                    </div>
                </div>
            </div>

            <!-- San pham cung loai -->
            <div class="mt-24">
                <h2 class="text-2xl font-bold tracking-tight text-gray-900">Sản phẩm cùng loại</h2>
                <div class="mt-6 grid grid-cols-1 gap-y-10 sm:grid-cols-2 lg:grid-cols-4 xl:gap-x-8">
                    @foreach (var product in Model.RelatedProducts)
                    {
                        <partial name="Shared/_ProductCard" model="product" />
                    }
                </div>
            </div>
        }
        else
        {
            <!-- Neu KHONG tim thay san pham -->
            <div class="text-center">
                <h1 class="text-3xl font-bold text-gray-900">404 - Không tìm thấy sản phẩm</h1>
                <p class="mt-4 text-lg text-gray-600">Sản phẩm bạn đang tìm kiếm không tồn tại.</p>
                <div class="mt-10">
                    <a asp-page="/Index" class="rounded-md bg-blue-600 px-3.5 py-2.5 text-sm font-semibold text-white shadow-sm hover:bg-blue-700">
                        Quay về Trang Chủ
                    </a>
                </div>
            </div>
        }
    </div>
</div>

@section Scripts {
    <!-- Trang nay khong can script dac biet -->
}