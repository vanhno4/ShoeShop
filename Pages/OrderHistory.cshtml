@page
@model ShoeShop.Pages.OrderHistoryModel
@{
    ViewData["Title"] = "Lịch sử mua hàng";
}

<div class="bg-gray-50 min-h-screen py-10 px-4 sm:px-6 lg:px-8">
    <div class="max-w-5xl mx-auto">
        <h1 class="text-3xl font-bold text-gray-900 mb-8">Lịch sử đơn hàng</h1>

        @if (Model.SuccessMessage != null)
        {
            <div class="mb-4 bg-green-100 border border-green-400 text-green-700 px-4 py-3 rounded">
                @Model.SuccessMessage
            </div>
        }
        @if (Model.ErrorMessage != null)
        {
            <div class="mb-4 bg-red-100 border border-red-400 text-red-700 px-4 py-3 rounded">
                @Model.ErrorMessage
            </div>
        }

        @if (!Model.Orders.Any())
        {
            <div class="text-center py-16 bg-white rounded-lg shadow">
                <i class="fa-solid fa-receipt text-6xl text-gray-300 mb-4"></i>
                <p class="text-gray-500 text-lg">Bạn chưa có đơn hàng nào.</p>
                <a asp-page="/Index" class="mt-4 inline-block text-indigo-600 font-medium hover:text-indigo-800">
                    Đi mua sắm ngay &rarr;
                </a>
            </div>
        }
        else
        {
            <div class="space-y-6">
                @foreach (var order in Model.Orders)
                {
                    <div class="bg-white border border-gray-200 rounded-lg shadow-sm overflow-hidden">

                        <div class="bg-gray-100 px-6 py-4 border-b border-gray-200 flex flex-wrap justify-between items-center gap-4">
                            <div>
                                <p class="text-sm font-bold text-gray-900">Đơn hàng #@order.Id</p>
                                <p class="text-xs text-gray-500">Ngày đặt: @order.OrderDate.ToString("dd/MM/yyyy HH:mm")</p>
                            </div>
                            <div class="flex items-center space-x-4">
                                <p class="font-bold text-indigo-600 text-lg">@order.TotalAmount.ToString("N0") ₫</p>

                                <span class="px-3 py-1 rounded-full text-xs font-medium
                                              @(order.Status == "Đã hủy" ? "bg-red-100 text-red-800" : "bg-green-100 text-green-800")">
                                    @order.Status
                                </span>

                                @if (order.Status == "Đang chờ vận chuyển")
                                {
                                    <form method="post" asp-page-handler="Cancel" asp-route-orderId="@order.Id" onsubmit="return confirm('Bạn có chắc muốn hủy đơn này?');">
                                        <button type="submit" class="text-sm text-red-600 hover:text-red-900 font-medium underline ml-2">Hủy đơn</button>
                                    </form>
                                }
                            </div>
                        </div>

                        <div class="divide-y divide-gray-100">
                            @foreach (var item in order.OrderItems)
                            {
                                <div class="p-6 flex items-center hover:bg-gray-50 transition">

                                    <div class="h-20 w-20 flex-shrink-0 overflow-hidden rounded-md border border-gray-200 bg-white">
                                        @if (item.Product != null)
                                        {
                                            <img src="@item.Product.ImageUrl" alt="@item.Product.Name" class="h-full w-full object-cover object-center">
                                        }
                                        else
                                        {
                                            <div class="h-full w-full flex items-center justify-center bg-gray-100 text-xs text-gray-400">
                                                No Image
                                            </div>
                                        }
                                    </div>

                                    <div class="ml-6 flex-1">
                                        <div class="flex justify-between">
                                            <h4 class="text-base font-medium text-gray-900">
                                                @(item.Product?.Name ?? "Sản phẩm không tồn tại")
                                            </h4>
                                            <p class="text-sm font-medium text-gray-900">@item.PricePaid.ToString("N0") ₫</p>
                                        </div>
                                        <div class="mt-1 flex items-center text-sm text-gray-500 space-x-4">
                                            <span class="bg-gray-100 px-2 py-0.5 rounded border">Size: <strong>@item.Size</strong></span>
                                            <span>Số lượng: x @item.Quantity</span>
                                        </div>
                                    </div>

                                </div>
                            }
                        </div>
                    </div>
                }
            </div>
        }
    </div>
</div>