@page
@model ShoeShop.Pages.GiamGiaModel
@{
    ViewData["Title"] = "Giảm Giá";
    // 1. Đặt màu nền (vàng nhạt, hợp với ảnh sản phẩm Giảm Giá)
    ViewData["BackgroundColor"] = "bg-yellow-50";
}

<!-- 2. Đã xóa class "bg-white" ở div dưới đây -->
<div>
    <div class="max-w-7xl mx-auto py-12 px-4 sm:px-6 lg:px-8">

        <h2 class="text-3xl font-extrabold tracking-tight text-gray-900 text-center">
            Sản Phẩm Giảm Giá
        </h2>
        <p class="mt-4 text-base text-gray-500 text-center">
            Cơ hội săn giày tốt với giá ưu đãi nhất.
        </p>

        <div class="mt-10 grid grid-cols-1 gap-y-10 sm:grid-cols-2 lg:grid-cols-4 xl:gap-x-8">

            @foreach (var product in Model.Products)
            {
                <partial name="Shared/_ProductCard" model="product" />
            }

        </div>

    </div>
</div>