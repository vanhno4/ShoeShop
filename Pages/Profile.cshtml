@page
@model ShoeShop.Pages.ProfileModel
@{
    ViewData["Title"] = "Thông Tin Tài Khoản";
    ViewData["BackgroundColor"] = "bg-gray-50";
}

<div class="max-w-4xl mx-auto py-12 px-4 sm:px-6 lg:px-8">
    <h1 class="text-3xl font-bold tracking-tight text-gray-900 mb-8">
        Thông Tin Tài Khoản
    </h1>

    @if (Model.UserFound)
    {
        <!-- Neu tim thay User -->
        <div class="bg-white shadow overflow-hidden rounded-lg border border-gray-200">
            <div class="px-4 py-5 sm:px-6">
                <h3 class="text-lg leading-6 font-medium text-gray-900">
                    Chào, @Model.ProfileUser.Username!
                </h3>
                <p class="mt-1 max-w-2xl text-sm text-gray-500">
                    Đây là thông tin chi tiết về tài khoản của bạn.
                </p>
            </div>
            <div class="border-t border-gray-200">
                <dl>
                    <!-- Ten dang nhap -->
                    <div class="bg-gray-50 px-4 py-5 sm:grid sm:grid-cols-3 sm:gap-4 sm:px-6">
                        <dt class="text-sm font-medium text-gray-500">Tên đăng nhập (Username)</dt>
                        <dd class="mt-1 text-sm text-gray-900 sm:mt-0 sm:col-span-2">
                            @Model.ProfileUser.Username
                        </dd>
                    </div>
                    <!-- Email -->
                    <div class="bg-white px-4 py-5 sm:grid sm:grid-cols-3 sm:gap-4 sm:px-6">
                        <dt class="text-sm font-medium text-gray-500">Email</dt>
                        <dd class="mt-1 text-sm text-gray-900 sm:mt-0 sm:col-span-2">
                            @Model.ProfileUser.Email
                        </dd>
                    </div>
                    <!-- Ngay tham gia -->
                    <div class="bg-gray-50 px-4 py-5 sm:grid sm:grid-cols-3 sm:gap-4 sm:px-6">
                        <dt class="text-sm font-medium text-gray-500">Ngày tham gia</dt>
                        <dd class="mt-1 text-sm text-gray-900 sm:mt-0 sm:col-span-2">
                            @Model.ProfileUser.CreatedAt.ToString("dd/MM/yyyy")
                        </dd>
                    </div>
                    <!-- Tong don hang -->
                    <div class="bg-white px-4 py-5 sm:grid sm:grid-cols-3 sm:gap-4 sm:px-6">
                        <dt class="text-sm font-medium text-gray-500">Tổng số đơn hàng đã mua</dt>
                        <dd class="mt-1 text-sm text-gray-900 sm:mt-0 sm:col-span-2">
                            @Model.TotalOrders
                        </dd>
                    </div>
                </dl>
            </div>
        </div>

        <div class="mt-8">
            <a asp-page="/OrderHistory" class="rounded-md bg-blue-600 px-3.5 py-2.5 text-sm font-semibold text-white shadow-sm hover:bg-blue-700">
                Xem Lịch Sử Mua Hàng
            </a>
        </div>
    }
    else
    {
        <!-- Neu khong tim thay User (vi du: loi cookie) -->
        <p>Không tìm thấy thông tin người dùng. Vui lòng đăng nhập lại.</p>
    }
</div>