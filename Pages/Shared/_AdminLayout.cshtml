@using System.Text.Json
@inject IHttpContextAccessor HttpContextAccessor
@{
    // (Khong can logic gio hang o day)
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewData["Title"] - Admin Panel</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <script src="//unpkg.com/alpinejs" defer></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
    <style>
        body {
            font-family: 'Inter', sans-serif;
        }
    </style>
</head>
<body class="bg-gray-100">
    <div x-data="{ sidebarOpen: false }" class="flex h-screen bg-gray-100">

        <!-- 1. Sidebar (Menu ben trai) -->
        <aside class="fixed inset-y-0 left-0 z-30 w-64 bg-gray-900 text-gray-200 transform transition-transform duration-300 lg:translate-x-0"
               :class="{'translate-x-0': sidebarOpen, '-translate-x-full': !sidebarOpen}">

            <div class="flex items-center justify-between p-4 h-16 border-b border-gray-700">
                <span class="text-2xl font-bold text-white">ShoeVibe Admin</span>
                <button @@click="sidebarOpen = false" class="lg:hidden text-gray-400 hover:text-white">
                    <i class="fa-solid fa-times"></i>
                </button>
            </div>

            <!-- Cac link dieu huong -->
            <nav class="py-4">
                <a asp-page="/Admin/Index" class="flex items-center px-4 py-3 text-gray-100 hover:bg-gray-700">
                    <i class="fa-solid fa-tachometer-alt w-6 mr-3"></i>
                    Admin Dashboard
                </a>

                <!-- --- SUA LINK O DAY --- -->
                <a asp-page="/Admin/AllOrders" class="flex items-center px-4 py-3 mt-2 text-gray-100 hover:bg-gray-700">
                    <i class="fa-solid fa-file-invoice-dollar w-6 mr-3"></i>
                    Lịch sử mua hàng (All)
                </a>
                <!-- --- KET THUC SUA --- -->

                <a asp-page="/Index" class="flex items-center px-4 py-3 mt-2 text-gray-100 hover:bg-gray-700">
                    <i class="fa-solid fa-store w-6 mr-3"></i>
                    Trang chủ (Store)
                </a>
                <a asp-page="/AllProducts" class="flex items-center px-4 py-3 mt-2 text-gray-100 hover:bg-gray-700">
                    <i class="fa-solid fa-boxes-stacked w-6 mr-3"></i>
                    Tất cả sản phẩm (Store)
                </a>
            </nav>
        </aside>

        <!-- 2. Phan noi dung chinh (Ben phai) -->
        <div class="flex-1 flex flex-col overflow-hidden transition-all duration-300 lg:ml-64">

            <header class="flex items-center justify-between h-16 px-6 bg-white border-b border-gray-200">
                <button @@click.stop="sidebarOpen = true" class="lg:hidden text-gray-600">
                    <i class="fa-solid fa-bars fa-lg"></i>
                </button>
                <h1 class="text-xl font-semibold">@ViewData["Title"]</h1>
                <div class="flex items-center space-x-4">
                    <span class="text-gray-600">Chào, @User.Identity?.Name!</span>
                    <a asp-page="/Logout" class="text-indigo-600 hover:text-indigo-800 font-medium">
                        Đăng Xuất
                    </a>
                </div>
            </header>

            <main class="flex-1 overflow-x-hidden overflow-y-auto bg-gray-100 p-6">
                @RenderBody()
            </main>
        </div>
    </div>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>