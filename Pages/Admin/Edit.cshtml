@page "/Admin/Edit/{id:int}"
@model ShoeShop.Pages.Admin.EditModel
@{
    ViewData["Title"] = "Sửa Sản Phẩm";
}

<!-- Thong bao thanh cong -->
@if (!string.IsNullOrEmpty(Model.SuccessMessage))
{
    <div class="bg-green-100 border-l-4 border-green-500 text-green-700 p-4 mb-6" role="alert">
        <p class="font-bold">Thành công</p>
        <p>@Model.SuccessMessage</p>
    </div>
}

<form method="post" class="lg:grid lg:grid-cols-3 lg:gap-8">

    <!-- Truong an -->
    <input type="hidden" asp-for="Product.Id" />
    <input type="hidden" asp-for="Product.ImageUrl" />
    <input type="hidden" asp-for="Product.Category" />

    <!-- COT 1 & 2: THONG TIN SUA -->
    <div class="lg:col-span-2">
        <div class="bg-white shadow rounded-lg">
            <div class="px-4 py-5 sm:p-6">
                <h3 class="text-lg font-medium leading-6 text-gray-900">Base Information</h3>
                <p class="mt-1 text-sm text-gray-500">Sửa thông tin cơ bản của sản phẩm.</p>

                <div class="mt-6 grid grid-cols-1 gap-y-6 gap-x-4 sm:grid-cols-6">
                    <!-- Ten San Pham -->
                    <div class="sm:col-span-6">
                        <label asp-for="Product.Name" class="block text-sm font-medium text-gray-700">Tên sản phẩm</label>
                        <input type="text" asp-for="Product.Name" class="mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 sm:text-sm">
                    </div>

                    <!-- Mo Ta -->
                    <div class="sm:col-span-6">
                        <label asp-for="Product.Description" class="block text-sm font-medium text-gray-700">Mô tả</label>
                        <textarea asp-for="Product.Description" rows="5" class="mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 sm:text-sm"></textarea>
                    </div>

                    <!-- Gia Goc -->
                    <div class="sm:col-span-3">
                        <label asp-for="Product.OriginalPrice" class="block text-sm font-medium text-gray-700">Giá Gốc (Bị gạch đi)</label>
                        <input type="number" asp-for="Product.OriginalPrice" class="mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 sm:text-sm" placeholder="(Bỏ trống nếu không giảm giá)">
                    </div>

                    <!-- Gia Ban -->
                    <div class="sm:col-span-3">
                        <label asp-for="Product.Price" class="block text-sm font-medium text-gray-700">Giá Bán (Giá sau giảm)</label>
                        <input type="number" asp-for="Product.Price" class="mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 sm:text-sm">
                    </div>
                </div>
            </div>
            <div class="bg-gray-50 px-4 py-3 text-right sm:px-6">
                <button type="submit" class="inline-flex justify-center rounded-md border border-transparent bg-indigo-600 py-2 px-4 text-sm font-medium text-white shadow-sm hover:bg-indigo-700 focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:ring-offset-2">
                    Save Changes
                </button>
            </div>
        </div>
    </div>

    <!-- COT 3: PREVIEW VA KHO -->
    <div class="mt-6 lg:mt-0 lg:col-span-1">
        <!-- Preview -->
        <div class="bg-white shadow rounded-lg overflow-hidden">
            <h3 class="px-4 py-5 sm:p-6 text-lg font-medium leading-6 text-gray-900">Preview</h3>
            <div class="border-t border-gray-200">
                <div class="w-full overflow-hidden bg-gray-100" style="aspect-ratio: 1 / 1;">
                    <img src="@Model.Product.ImageUrl" alt="@Model.Product.Name" class="w-full h-full object-cover object-center">
                </div>
                <div class="p-4 space-y-2">
                    <h3 class="text-sm font-medium text-gray-900">@Model.Product.Name</h3>
                    <p class="text-lg font-semibold text-gray-900">@Model.Product.Price.ToString("N0") ₫</p>
                </div>
            </div>
        </div>

        <!--
            --- SUA LAI PHAN TON KHO ---
        -->
        <div class="mt-6 bg-white shadow rounded-lg">
            <div class="px-4 py-5 sm:p-6">
                <h3 class="text-lg font-medium leading-6 text-gray-900">Sizes & Inventory</h3>
                <p class="mt-1 text-sm text-gray-500">
                    Chỉnh sửa số lượng tồn kho cho từng size.
                </p>

                <!-- Sizes (Hien thi tinh) -->
                <div class="mt-6 flex space-x-2">
                    <span class="inline-flex items-center rounded-md bg-indigo-100 px-3 py-1 text-sm font-medium text-indigo-800">M</span>
                    <span class="inline-flex items-center rounded-md bg-indigo-100 px-3 py-1 text-sm font-medium text-indigo-800">L</span>
                    <span class="inline-flex items-center rounded-md bg-indigo-100 px-3 py-1 text-sm font-medium text-indigo-800">XL</span>
                </div>

                <!-- Ton Kho (Chinh sua duoc) -->
                <div class="mt-6 space-y-4">
                    <div>
                        <label asp-for="StockM" class="block text-sm font-medium text-gray-700">Tồn kho (Size M)</label>
                        <input type="number" asp-for="StockM" class="mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 sm:text-sm">
                    </div>
                    <div>
                        <label asp-for="StockL" class="block text-sm font-medium text-gray-700">Tồn kho (Size L)</label>
                        <input type="number" asp-for="StockL" class="mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 sm:text-sm">
                    </div>
                    <div>
                        <label asp-for="StockXL" class="block text-sm font-medium text-gray-700">Tồn kho (Size XL)</label>
                        <input type="number" asp-for="StockXL" class="mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 sm:text-sm">
                    </div>
                    <div class="border-t pt-4">
                        <label asp-for="Product.Stock" class="block text-sm font-medium text-gray-700">Tổng Tồn Kho (Tự động)</label>
                        <!-- Hien thi tong nhung khong cho sua -->
                        <input type="number" asp-for="Product.Stock" readonly class="mt-1 block w-full rounded-md border-gray-300 shadow-sm sm:text-sm bg-gray-100 text-gray-500">
                    </div>
                </div>
            </div>
        </div>
        <!-- --- KET THUC SUA --- -->
    </div>
</form>