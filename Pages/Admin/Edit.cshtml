@page "/Admin/Edit/{id:int}"
@model ShoeShop.Pages.Admin.EditModel
@{
    ViewData["Title"] = "Sửa Sản Phẩm";
    Layout = "/Pages/Shared/_AdminLayout.cshtml";
}

<div class="max-w-6xl mx-auto">
    <div class="flex items-center justify-between mb-6">
        <div>
            <h2 class="text-2xl font-bold text-gray-900">Sửa thông tin sản phẩm</h2>
            <p class="text-sm text-gray-500">ID: #@Model.Product.Id</p>
        </div>

        <a asp-page="/Admin/Index" class="flex items-center px-4 py-2 bg-gray-200 text-gray-700 rounded hover:bg-gray-300 transition">
            <i class="fa-solid fa-arrow-left mr-2"></i> Quay lại Dashboard
        </a>
    </div>

    @if (!string.IsNullOrEmpty(Model.SuccessMessage))
    {
        <div class="bg-green-100 border-l-4 border-green-500 text-green-700 p-4 mb-6 rounded shadow-sm">
            <i class="fa-solid fa-check-circle mr-2"></i> @Model.SuccessMessage
        </div>
    }

    <form method="post" class="grid grid-cols-1 lg:grid-cols-3 gap-8">
        <input type="hidden" asp-for="Product.Id" />

        <div class="lg:col-span-2 space-y-6">
            <div class="bg-white shadow rounded-lg p-6">
                <h3 class="text-lg font-medium text-gray-900 border-b pb-3 mb-4">Thông tin chung</h3>

                <div class="grid grid-cols-1 gap-6">
                    <div>
                        <label class="block text-sm font-medium text-gray-700">Tên sản phẩm</label>
                        <input asp-for="Product.Name" class="mt-1 w-full border-gray-300 rounded-md shadow-sm p-2 border focus:ring-indigo-500">
                    </div>

                    <div class="grid grid-cols-2 gap-4">
                        <div>
                            <label class="block text-sm font-medium text-gray-700">Giá bán (VNĐ)</label>
                            <input asp-for="Product.Price" type="number" class="mt-1 w-full border-gray-300 rounded-md shadow-sm p-2 border font-bold text-indigo-600">
                        </div>
                        <div>
                            <label class="block text-sm font-medium text-gray-700">Giá gốc (VNĐ)</label>
                            <input asp-for="Product.OriginalPrice" type="number" class="mt-1 w-full border-gray-300 rounded-md shadow-sm p-2 border text-gray-500">
                        </div>
                    </div>

                    <div>
                        <label class="block text-sm font-medium text-gray-700">Danh mục</label>
                        <select asp-for="Product.Category" class="mt-1 w-full border-gray-300 rounded-md shadow-sm p-2 border">
                            <option value="Nam">Nam</option>
                            <option value="Nữ">Nữ</option>
                            <option value="Trẻ Em">Trẻ Em</option>
                            <option value="Giảm Giá">Giảm Giá</option>
                        </select>
                    </div>

                    <div>
                        <label class="block text-sm font-medium text-gray-700">Mô tả</label>
                        <textarea asp-for="Product.Description" rows="5" class="mt-1 w-full border-gray-300 rounded-md shadow-sm p-2 border"></textarea>
                    </div>
                </div>
            </div>
        </div>

        <div class="space-y-6">

            <div class="bg-white shadow rounded-lg p-6">
                <h3 class="text-lg font-medium text-gray-900 border-b pb-3 mb-4">Hình ảnh</h3>

                <div class="mb-4 aspect-w-1 aspect-h-1 w-full overflow-hidden rounded-lg bg-gray-100 border">
                    <img src="@Model.Product.ImageUrl" alt="Preview" class="h-full w-full object-cover object-center">
                </div>

                <div>
                    <label class="block text-sm font-medium text-gray-700">Link Ảnh (URL)</label>
                    <input asp-for="Product.ImageUrl" class="mt-1 w-full border-gray-300 rounded-md shadow-sm p-2 border text-sm text-gray-500">
                </div>
            </div>

            <button type="submit" class="w-full py-3 px-4 border border-transparent rounded-md shadow-sm text-base font-medium text-white bg-indigo-600 hover:bg-indigo-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-indigo-500 shadow-lg transition">
                Lưu Thay Đổi
            </button>
        </div>
    </form>
</div>